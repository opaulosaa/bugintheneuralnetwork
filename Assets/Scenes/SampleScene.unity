--- !u!114 &902797467
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 902797465}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.8, g: 0.83, b: 0.92, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 1bb8e13b870b91344b4c1bb07c8d5f2b, type: 3}
    m_FontSize: 34
    m_FontStyle: 0
    m_BestFit: 1
    m_MinSize: 14
    m_MaxSize: 34
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 0.95
  m_Text: "Mover Cris: W A S D ou as setas.\nInteragir: tecla E, perto de um objeto. Esc fecha o painel.\nDentro dos puzzles: clique nas op\xE7\xF5es com o mouse.\n\nPuzzle 1 \xB7 Escrivaninha: monte a fila de prioridade de hoje.\nPuzzle 2 \xB7 Mural: fa\xE7a o la\xE7o de pensamento terminar.\nPuzzle 3 \xB7 Celular: ajuste as regras do firewall.\nPuzzle 4 \xB7 Notebook: desfa\xE7a o deadlock.\nPuzzle 5 \xB7 Sacos de lixo: rode o coletor de lixo.\nCada puzzle resolvido arruma uma parte do quarto. Depois dos cinco, abra a Cortina.\n\nA Vontade \xE9 a luz em volta de Cris: sobe quando voc\xEA avan\xE7a e desce com erros. Se ficar muito tempo parado, o cora\xE7\xE3o acelera. Sem pressa, mas siga em frente."
