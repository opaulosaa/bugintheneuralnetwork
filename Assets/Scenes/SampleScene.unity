  m_Script: {fileID: 11500000, guid: b3e75afae36043f4da30779a8e36f94e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PuzzleDeadlock
  textoPrompt: "Puzzle 4 \xB7 Aperte E: Notebook"
  interagivel: 1
  painel: {fileID: 2033718530}
  textoFeedback: {fileID: 1763825559}
  storyState: {fileID: 1500830518}
  numeroPuzzle: 4
  processos:
  - nome: Abrir os slides
    posicao: {x: -420, y: 10}
  - nome: Sentir-se capaz
    posicao: {x: -60, y: 150}
  - nome: Ensaiar
    posicao: {x: 30, y: -120}
  - nome: Descansar
    posicao: {x: 400, y: 90}
  esperas:
  - de: 0
    para: 1
    motivo: "s\xF3 abro quando me sentir capaz"
    real: 0
    porQueReal: 
    posicaoRotulo: {x: -330, y: 100}
  - de: 1
    para: 2
    motivo: me sinto capaz depois de ensaiar
    real: 1
    porQueReal: "Ensaiar d\xE1 seguran\xE7a de verdade."
    posicaoRotulo: {x: 60, y: 22}
  - de: 2
    para: 0
    motivo: ensaiar precisa dos slides abertos
    real: 1
    porQueReal: "N\xE3o d\xE1 para ensaiar sem os slides."
    posicaoRotulo: {x: -270, y: -92}
  - de: 1
    para: 3
    motivo: me sinto capaz depois de descansar
    real: 1
    porQueReal: "Cansa\xE7o demais derruba qualquer um."
    posicaoRotulo: {x: 200, y: 160}
  - de: 3
    para: 2
    motivo: "s\xF3 descanso depois de ensaiar tudo de novo"
    real: 0
    porQueReal: 
    posicaoRotulo: {x: 330, y: -36}
