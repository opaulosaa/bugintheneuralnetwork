  scanline: {fileID: 2800000, guid: 5950e55fdf4d192498697442190d1348, type: 3}
  frase1: Durante muito tempo, Cris achou que pedir ajuda era sinal de fraqueza.
  frase2: "N\xE3o \xE9. Procurar ajuda n\xE3o tem nada de vergonhoso."
  frase3: "\xC0s vezes vem de um amigo, \xE0s vezes da fam\xEDlia, \xE0s vezes de um profissional. Todo mundo precisa, em algum momento."
  titulo: "TODOS N\xD3S PRECISAMOS DE AJUDA"
  apoio: "Se voc\xEA precisa conversar: CVV, 188 (liga\xE7\xE3o gratuita, 24h) ou cvv.org.br\nCAPS e UBS da sua cidade  \xB7  Em emerg\xEAncia: SAMU 192"
  creditos: "Bug In The Neural Network  \xB7  Maria Clara Andrade, Enzo Lima, Natan Shinmon e Paulo Alencar  \xB7  CGRV, Unifor 2026"
  coresPessoas:
  - {r: 0.7, g: 0.85, b: 1, a: 1}
