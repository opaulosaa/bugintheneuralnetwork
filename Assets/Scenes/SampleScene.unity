  m_Script: {fileID: 11500000, guid: 3297579d970cc0a439ffd7984fcf917a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PuzzleLoop
  textoPrompt: "Puzzle 2 \xB7 Aperte E: Quadro"
  interagivel: 1
  painel: {fileID: 789148217}
  textoFeedback: {fileID: 876507988}
  storyState: {fileID: 1500830518}
  condicoes:
  - verdadeiro
  - '!tudoPerfeito'
  - '!alguemConcorda'
  - '!temEvidencia'
  explicacaoCondicao:
  - "\"verdadeiro\" nunca vira falso: esse la\xE7o n\xE3o tem porta de sa\xEDda."
  - "Para sair, tudo teria que ficar perfeito. Isso nunca acontece, ent\xE3o o la\xE7o nunca termina."
  - "A sa\xEDda ficou na m\xE3o dos outros, e ningu\xE9m sabe que esse la\xE7o est\xE1 rodando."
  - 
  rotulosCorpo:
  - pensar de novo
  - esperar passar
  - pedir desculpas
  - lembrar conquistas
  codigoCorpo:
  - "pensar(\"Eu n\xE3o dou conta.\");"
  - esperar(cansaco.passar);
  - pedirDesculpas(todos);
  - temEvidencia = lembrarConquistas();
  condicaoCerta: 3
  corpoCerto: 3
  opcoes: []
